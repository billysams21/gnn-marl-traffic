<?xml version="1.0"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
  <input>
    <net-file value="toronto_small.net.xml"/>
    <route-files value="toronto_small_cars.rou.xml,toronto_small_truck.rou.xml"/>
    <additional-files value="toronto_small_cars_vtype.rou.xml,toronto_small_truck_vtype.rou.xml,e1_detectors.add.xml,e2_detectors.add.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="3600"/>
  </time>
  <report>
    <no-warnings value="false"/>
  </report>
</configuration>
