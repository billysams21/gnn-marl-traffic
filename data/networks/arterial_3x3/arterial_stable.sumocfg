<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="arterial_fixed.net.xml"/>
        <route-files value="arterial_stable.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>
    <processing>
        <lateral-resolution value="0.7"/>
        <time-to-teleport value="300"/>
        <ignore-route-errors value="true"/>
    </processing>
    <report>
        <verbose value="false"/>
        <no-step-log value="true"/>
    </report>
</configuration>
